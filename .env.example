# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=오 웰니스

# --- Database (Neon Postgres) ---
# Use the pooled URL for app runtime; unpooled URL for migrations.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host-unpooled/dbname?sslmode=require

# --- Auth.js v5 ---
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# Comma-separated list of emails allowed to sign in as admin
ADMIN_EMAILS=admin@example.com

# --- Resend (magic link + newsletter) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=Oh Wellness <hello@example.com>
RESEND_AUDIENCE_ID=

# --- Vercel Blob (media uploads) ---
BLOB_READ_WRITE_TOKEN=

# --- Analytics & SEO verification ---
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# --- HMAC secrets ---
NEWSLETTER_CONFIRM_SECRET=replace-with-openssl-rand-base64-32
REVALIDATE_SECRET=replace-with-openssl-rand-base64-32
