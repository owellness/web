# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=오! 웰니스

# --- Database (Neon Postgres) ---
# Use the pooled URL for app runtime; unpooled URL for migrations.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host-unpooled/dbname?sslmode=require

# --- Auth.js v5 (admin id/pw login) ---
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# Admin credentials (id / password). Use a strong password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional: display name + email used for article authorship
ADMIN_NAME=관리자
ADMIN_EMAIL=admin@admin.local

# --- Resend (newsletter only) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=O! Wellness <hello@example.com>
RESEND_AUDIENCE_ID=

# --- Vercel Blob (media uploads) ---
BLOB_READ_WRITE_TOKEN=

# --- Analytics & SEO verification ---
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# --- HMAC secrets ---
NEWSLETTER_CONFIRM_SECRET=replace-with-openssl-rand-base64-32
REVALIDATE_SECRET=replace-with-openssl-rand-base64-32
