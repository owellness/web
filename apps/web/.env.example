# --- App ---
# IMPORTANT: in production set this to your real public origin (e.g.
# https://oh-wellness.vercel.app). If left unset, robots.txt / sitemap.xml /
# canonical tags fall back to the Vercel production domain, and only to
# http://localhost:3000 as a last resort — localhost URLs block Google indexing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=오! 웰니스

# --- Database (Neon Postgres) ---
# Use the pooled URL for app runtime; unpooled URL for migrations.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host-unpooled/dbname?sslmode=require

# --- Auth.js v5 (admin id/pw + public Kakao login) ---
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
# Kakao Developers REST API key / Client Secret.
# Register this redirect URI: {AUTH_URL}/api/auth/callback/kakao
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
# Admin credentials (id / password). Use a strong password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional: display name + email used for article authorship
ADMIN_NAME=관리자
ADMIN_EMAIL=admin@admin.local

# --- Resend (newsletter only) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=O! Wellness <hello@example.com>
RESEND_AUDIENCE_ID=

# --- Vercel Blob (media uploads) ---
BLOB_READ_WRITE_TOKEN=

# --- Analytics & SEO verification ---
NEXT_PUBLIC_GA_ID=
# Google Search Console "HTML tag" verification token (the content="..." value).
# Set this, then submit https://<domain>/sitemap.xml in Search Console.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# --- HMAC secrets ---
NEWSLETTER_CONFIRM_SECRET=replace-with-openssl-rand-base64-32
REVALIDATE_SECRET=replace-with-openssl-rand-base64-32

# --- External wellness briefing ---
# Vercel Cron authenticates with this value. Use a separate random secret.
CRON_SECRET=replace-with-openssl-rand-base64-32
# Naver Cloud Papago Translation credentials (server-only).
PAPAGO_CLIENT_ID=
PAPAGO_CLIENT_SECRET=
# Keep empty until translation/republishing permission has been confirmed for
# each source. Comma-separated keys: nutritionfacts,gowinglife,gwi
EXTERNAL_TRANSLATION_ALLOWED_SOURCES=

# 모바일 앱 API v1 — Bearer JWT 서명 비밀 (32바이트 이상 랜덤)
APP_JWT_SECRET=
